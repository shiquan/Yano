#!/usr/bin/env sh

## this configure file is edited from data.table/configure. Credit to original authors.

# Find R compilers
CC=`${R_HOME}/bin/R CMD config CC`
CFLAGS=`${R_HOME}/bin/R CMD config CFLAGS`

# gcc compiler info to output #3291
case $CC in gcc*)
  GCCV=`${CC} -dumpfullversion -dumpversion`
  echo "$CC $GCCV"
esac

# Test whether the C toolchain can build and link an OpenMP program.
# PKG_CFLAGS / PKG_LIBS are passed to R CMD SHLIB because
# SHLIB_OPENMP_CFLAGS is not set in every R installation (notably the
# Homebrew macOS build).
try_openmp() {
  PKG_CFLAGS="$1" PKG_LIBS="$2" "${R_HOME}/bin/R" CMD SHLIB -o test-omp.so test-omp.c >/dev/null 2>&1
}

find_libomp() {
  for prefix in /opt/homebrew/opt/libomp /usr/local/opt/libomp /opt/local; do
    if [ -f "$prefix/include/omp.h" ]; then
      echo "$prefix"
      return 0
    fi
  done
  if command -v brew >/dev/null 2>&1; then
    prefix=`brew --prefix libomp 2>/dev/null`
    if [ -n "$prefix" ] && [ -f "$prefix/include/omp.h" ]; then
      echo "$prefix"
      return 0
    fi
  fi
  return 1
}

cat <<EOF > test-omp.c
#include <omp.h>
int main() {
  return omp_get_num_threads();
}
EOF

R_NO_OPENMP=0
OMP_CFLAGS=
OMP_LIBS=

# Prefer the flags R reports, if any.
RC_OMP=`"${R_HOME}/bin/R" CMD config SHLIB_OPENMP_CFLAGS 2>/dev/null`
case $RC_OMP in
  *ERROR*|"") RC_OMP= ;;
esac

if [ -n "$RC_OMP" ]; then
  if try_openmp "$RC_OMP" "$RC_OMP"; then
    OMP_CFLAGS="$RC_OMP"
    OMP_LIBS="$RC_OMP"
    echo "OpenMP supported (R SHLIB_OPENMP_CFLAGS)"
  else
    R_NO_OPENMP=1
  fi
elif [ "`uname -s`" = "Darwin" ] && LIBOMP=`find_libomp`; then
  CAND_CFLAGS="-Xpreprocessor -fopenmp -I$LIBOMP/include"
  CAND_LIBS="-L$LIBOMP/lib -lomp"
  if try_openmp "$CAND_CFLAGS" "$CAND_LIBS"; then
    OMP_CFLAGS="$CAND_CFLAGS"
    OMP_LIBS="$CAND_LIBS"
    echo "OpenMP supported (libomp at $LIBOMP)"
  else
    R_NO_OPENMP=1
  fi
else
  if try_openmp "-fopenmp" "-fopenmp"; then
    OMP_CFLAGS="-fopenmp"
    OMP_LIBS="-fopenmp"
    echo "OpenMP supported (-fopenmp)"
  else
    R_NO_OPENMP=1
  fi
fi

# Clean up.
rm -f test-omp.* a.out

# Write to Makevars
if [ "$R_NO_OPENMP" = "1" ]; then
  echo "*** OpenMP not supported! Yano uses OpenMP to perform Spatial dissimilarity test."
  OMP_CFLAGS=
  OMP_LIBS=
fi
sed -e "s|@openmp_cflags@|$OMP_CFLAGS|" -e "s|@openmp_libs@|$OMP_LIBS|" src/Makevars.in > src/Makevars
# retain user supplied PKG_ env variables, #4664. See comments in Makevars.in too.
sed -e "s|@PKG_CFLAGS@|$PKG_CFLAGS|" src/Makevars > src/Makevars.tmp && mv src/Makevars.tmp src/Makevars
sed -e "s|@PKG_LIBS@|$PKG_LIBS|" src/Makevars > src/Makevars.tmp && mv src/Makevars.tmp src/Makevars

exit 0
